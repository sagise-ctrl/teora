# Copy to .env and configure for your environment

# === SUPABASE (REQUIRED) ===
# Your Supabase project URL
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Supabase anon key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=[ANON-KEY]

# === API ===
# Enable MSW mock (true = use mock data, false = real API)
VITE_MOCK=true

# API base URL (empty = relative paths, set for production)
VITE_API_URL=
