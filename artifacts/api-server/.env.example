# Teora API Server — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# === REQUIRED ===

# Port the server listens on
PORT=8080

# PostgreSQL connection string (Supabase or self-hosted)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Connection pooler URL — use this for serverless (Vercel Functions).
# Format: same credentials as DATABASE_URL but host=aws-0-REGION.pooler.supabase.com port=6543
# Leave empty to use DATABASE_URL directly (local dev / VPS).
# Get pooler host from: Supabase Dashboard > Database > Connection Pooling
DATABASE_POOLER_URL=

# === SUPABASE ===

# Your Supabase project URL
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co

# Supabase JWT secret (for local dev JWT validation)
# Get from: Supabase Dashboard > Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=[YOUR-JWT-SECRET]

# Supabase service role key (for admin operations like creating users)
# Get from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# === AI PROVIDER ===

# AI provider: "openai" (default), "ollama", or custom URL
AI_PROVIDER=openai

# Base URL for AI API (defaults to OpenAI)
AI_BASE_URL=https://api.openai.com/v1

# API key for AI calls
AI_API_KEY=[YOUR-AI-API-KEY]

# Default model (e.g., gpt-4o-mini, gpt-4o)
AI_MODEL=gpt-4o-mini

# === OPTIONAL ===

# Node environment
NODE_ENV=production

# Directory for file uploads (default: /tmp/teora/uploads)
# UPLOAD_DIR=/tmp/teora/uploads

# Directory for exported files (default: /tmp/teora/exports)
# EXPORT_DIR=/tmp/teora/exports

# Stripe webhook secret (if using Stripe payments)
# WEBHOOK_SECRET=[YOUR-WEBHOOK-SECRET]

# === CORS ===

# Comma-separated list of allowed origins for CORS.
# Add your production frontend domain(s) here.
# Default (dev only): http://localhost:5173,http://localhost:18543
ALLOWED_ORIGINS=https://academic-workspace-eta.vercel.app,http://localhost:18543,http://localhost:5173
