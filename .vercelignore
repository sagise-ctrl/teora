# Dependencies
**/node_modules
**/.pnpm-store

# Build outputs
# Exclude dist/ folders EXCEPT the frontend one (artifacts/academic-workspace/dist).
# Vercel CLI deploy runs from artifacts/academic-workspace working-directory; it needs dist/ there.
# Listing explicitly instead of `**/dist` + negation because gitignore negation of directories is fragile.
artifacts/api-server/dist
lib/api-client-react/dist
lib/api-zod/dist
lib/db/dist
**/.next
**/out-tsc
**/tmp
**/temp

# Git
.git
.gitignore

# IDEs
**/.vscode
**/.idea
**/*.swp
**/.DS_Store

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Test coverage
coverage
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Docs
**/*.md
docs
README.md
CLAUDE.md

# CI/CD
.github
.claude

# MCP
.mcp.json

# Schema source
lib/api-spec

# Misc
pnpm-lock.yaml
package-lock.json
*.tsbuildinfo
